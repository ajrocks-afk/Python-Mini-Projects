def hanoi_solver(n):
    # Initialize rods: Rod A has disks n to 1, others are empty
    rods = {
        'A': list(range(n, 0, -1)),
        'B': [],
        'C': []
    }
    
    states = []

    def record_state():
        # Format the current rods as [list] [list] [list]
        state = f"{rods['A']} {rods['B']} {rods['C']}"
        states.append(state)

    def move(n, source, target, auxiliary):
        if n > 0:
            # Move n-1 disks from source to auxiliary
            move(n - 1, source, auxiliary, target)
            
            # Move the actual disk
            disk = rods[source].pop()
            rods[target].append(disk)
            record_state()
            
            # Move n-1 disks from auxiliary to target
            move(n - 1, auxiliary, target, source)

    # Record initial state
    record_state()
    
    # Solve starting from Rod A to Rod C using Rod B as auxiliary
    move(n, 'A', 'C', 'B')
    
    return "\n".join(states)