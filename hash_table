class HashTable:
    def __init__(self):
        # Initialize an empty dictionary to store hashed values
        self.collection = {}

    def hash(self, string):
        # Sum the Unicode (ASCII) values of each character
        return sum(ord(char) for char in string)

    def add(self, key, value):
        hash_key = self.hash(key)
        
        # If the hash_key doesn't exist, create a nested dictionary
        if hash_key not in self.collection:
            self.collection[hash_key] = {}
        
        # Store the key-value pair inside the nested dictionary
        self.collection[hash_key][key] = value

    def remove(self, key):
        hash_key = self.hash(key)
        
        # Check if the hash index and the specific key exist
        if hash_key in self.collection and key in self.collection[hash_key]:
            del self.collection[hash_key][key]
            
            # Optional: Clean up empty nested dictionaries
            if not self.collection[hash_key]:
                del self.collection[hash_key]

    def lookup(self, key):
        hash_key = self.hash(key)
        
        # Return the value if it exists, otherwise return None
        if hash_key in self.collection and key in self.collection[hash_key]:
            return self.collection[hash_key][key]
        return None